# Vector database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=orthopedic_cases

# Resultados de salida (informes generados), no el dataset de casos historicos
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=recovery_ia
MONGODB_REPORTS_COLLECTION=reports

# LLM provider (agente conversacional) y embeddings de texto: Nebius AI Studio
NEBIUS_API_KEY=
LLM_MODEL=Qwen/Qwen3-32B

# Embeddings de texto (notas diagnosticas). El embedding de imagen aun no esta
# implementado (ver src/recovery_ia/embeddings/image_embedder.py), por lo que
# no hay variable de configuracion para el todavia.
TEXT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# SMS (Vonage Messages API)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SMS_FROM=RecoverIA

# Dictado por voz del informe medico (SLNG Speech-to-Text, https://slng.ai)
SLNG_API_KEY=
SLNG_REGION=eu-west

# Login del profesional que usa la herramienta (credencial unica, sin gestion
# de usuarios). Cambiar ADMIN_PASSWORD y AUTH_SECRET_KEY en produccion.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
AUTH_SECRET_KEY=change-me-in-production
AUTH_TOKEN_TTL_HOURS=12
