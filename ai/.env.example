# Vector database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=orthopedic_cases

# Resultados de salida (informes generados), no el dataset de casos historicos
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=recovery_ia
MONGODB_REPORTS_COLLECTION=reports

# LLM provider (agente conversacional)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Embeddings de texto (notas diagnosticas). El embedding de imagen aun no esta
# implementado (ver src/recovery_ia/embeddings/image_embedder.py), por lo que
# no hay variable de configuracion para el todavia.
TEXT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
